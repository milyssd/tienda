# Local MariaDB/MySQL account; use an application-scoped user.
DATABASE_URL="mysql://nexo:CHANGE_ME@127.0.0.1:3306/nexo"
# At least 32 random characters. Server only, never NEXT_PUBLIC_.
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
APP_ORIGIN="http://localhost:3000"
# true only on HTTPS. Local development uses false.
COOKIE_SECURE="false"
# Enable only when Nginx accepts requests exclusively from cloudflared
# and strips/spoof-protects incoming CF-Connecting-IP.
TRUST_CLOUDFLARE="false"
ADMIN_EMAIL="admin@nexo.local"
# Required only for first seed; at least 14 characters, no default password.
ADMIN_PASSWORD=""
