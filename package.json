{
  "name": "nexo-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "stock:release": "node --env-file=.env --import tsx scripts/release-stock.ts",
    "stock:worker": "node --env-file=.env --import tsx scripts/stock-worker.ts",
    "prebuild": "npm run db:generate",
    "predev": "npm run db:generate",
    "pretypecheck": "npm run db:generate && next typegen"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@prisma/adapter-mariadb": "6.19.3",
    "@prisma/client": "6.19.3",
    "@prisma/driver-adapter-utils": "6.19.3",
    "bcryptjs": "3.0.2",
    "jose": "5.10.0",
    "lucide-react": "0.468.0",
    "mariadb": "3.5.4",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "10.4.22",
    "postcss": "8.5.31",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mariadb": "3.5.4",
    "postcss": "8.5.31"
  },
  "engines": {
    "node": "^22.14.0 || ^24.0.0",
    "npm": ">=10"
  }
}
